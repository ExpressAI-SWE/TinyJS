{
  "name": "tinyjs",
  "version": "0.1.0",
  "description": "A lightweight full-stack framework built on Preact and Vite",
  "type": "module",
  "bin": {
    "tinyjs": "bin/tinyjs.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "preact-render-to-string": "^6.6.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "preact": "^10.28.0",
    "three": "^0.187.0"
  },
  "exports": {
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./ai/client": {
      "types": "./dist/ai-client.d.ts",
      "import": "./dist/ai-client.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./terrain": {
      "types": "./dist/terrain.d.ts",
      "import": "./dist/terrain.js"
    },
    "./loading": {
      "types": "./dist/loading.d.ts",
      "import": "./dist/loading.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./routing": {
      "types": "./dist/route-tree.d.ts",
      "import": "./dist/route-tree.js"
    }
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
