{
  "name": "tinyjs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "compile": "tsc -p packages/tinyjs",
    "typecheck": "tsc -p examples/basic",
    "browser:install": "playwright-core install chromium",
    "test": "bun run compile && bun run typecheck && bun test",
    "dev": "bun run --cwd examples/basic dev",
    "build": "bun run --cwd examples/basic build",
    "start": "bun run --cwd examples/basic start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.58.0",
    "preact": "^10.28.0",
    "typescript": "~5.9.3"
  }
}
